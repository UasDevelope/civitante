	<string>We need Bluetooth access for notifications.</string>
	<key>NSCameraUsageDescription</key>
	<string>We need camera access to scan cards.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>We use Face ID for authentication.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>We need your location to provide location-based services.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>We need access to your location to display locations in the app</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We need access to your location to display locations in the app</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>We need microphone access for voice recognition features.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>We need permission to save photos to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>We need access to your photo library to pick images.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>We use speech synthesis for guiding users.</string>
	<key>NSUserNotificationUsageDescription</key>
	<string>We need notification permission to keep you updated.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
